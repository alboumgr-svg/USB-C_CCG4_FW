  67:.\common/main.c **** 
  68:.\common/main.c **** /*
  69:.\common/main.c ****  * Reserve 32 bytes of space for Customer related info.
  70:.\common/main.c ****  * Fill this with customer related info.
  71:.\common/main.c ****  * This will be placed at an offset of 0xC0 from the start of FW Image.
  72:.\common/main.c ****  */
  73:.\common/main.c **** __attribute__ ((section(".customer_region"), used))
  74:.\common/main.c **** const uint32_t customer_info[8] = {0x00};
  75:.\common/main.c **** 
  76:.\common/main.c **** /* Place the bootloader version at a fixed location, so that firmware can retrieve this as well. */
  77:.\common/main.c **** __attribute__ ((section(".base_version"), used))
  78:.\common/main.c **** const uint32_t base_version = FW_BASE_VERSION;
  79:.\common/main.c **** __attribute__ ((section(".app_version"), used))
  80:.\common/main.c **** const uint32_t app_version  = APP_VERSION;
  81:.\common/main.c **** __attribute__ ((section(".dev_siliconid"), used))
  82:.\common/main.c **** const uint32_t ccg_silicon_id = MAKE_DWORD_FROM_WORD (CCG_DEV_SILICON_ID, CCG_DEV_FAMILY_ID);
  83:.\common/main.c **** __attribute__ ((section(".fw_reserved"), used))
  84:.\common/main.c **** const uint32_t reserved_buf[5] = {0};
  85:.\common/main.c **** 
  86:.\common/main.c **** #if CCG_FIRMWARE_APP_ONLY
  87:.\common/main.c **** /*
  88:.\common/main.c ****    Provide a variable required by the HPI library. The real variable only
  89:.\common/main.c ****    exists if the boot-loadable component is included.
  90:.\common/main.c ****  */
  91:.\common/main.c **** volatile uint32_t cyBtldrRunType = 0;
  92:.\common/main.c **** #endif
  93:.\common/main.c **** 
  94:.\common/main.c **** /* Solution PD event handler */
  95:.\common/main.c **** void sln_pd_event_handler(uint8_t port, app_evt_t evt, const void *data)
  96:.\common/main.c **** {
  97:.\common/main.c **** #if (CCG_HPI_PD_ENABLE == 1)
  98:.\common/main.c ****     /* Pass the callback to HPI */
  99:.\common/main.c ****     hpi_pd_event_handler(port, evt, data);
 100:.\common/main.c **** #else /* (CCG_HPI_PD_ENABLE == 0) */
 101:.\common/main.c ****     (void)port;
 102:.\common/main.c ****     (void)evt;
 103:.\common/main.c ****     (void)data;
 104:.\common/main.c ****     /* Do nothing. */
 105:.\common/main.c **** #endif /* (CCG_HPI_PD_ENABLE) */
 106:.\common/main.c **** }
