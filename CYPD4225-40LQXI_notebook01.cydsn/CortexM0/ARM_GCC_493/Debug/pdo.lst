  49:.\src\app/pdo.c **** 
  50:.\src\app/pdo.c **** static uint32_t calc_power(uint32_t voltage, uint32_t current)
  51:.\src\app/pdo.c **** {
  52:.\src\app/pdo.c ****     /*
  53:.\src\app/pdo.c ****        Voltage is expressed in 50 mV units.
  54:.\src\app/pdo.c ****        Current is expressed in 10 mA units.
  55:.\src\app/pdo.c ****        Power should be expressed in 250 mW units.
  56:.\src\app/pdo.c ****      */
  57:.\src\app/pdo.c ****     return (DIV_ROUND_UP(voltage * current, 500));
  58:.\src\app/pdo.c **** }
  59:.\src\app/pdo.c **** 
  60:.\src\app/pdo.c **** static uint32_t calc_current(uint32_t power, uint32_t voltage)
  61:.\src\app/pdo.c **** {
  62:.\src\app/pdo.c ****     /*
  63:.\src\app/pdo.c ****        Power is expressed in 250 mW units.
  64:.\src\app/pdo.c ****        Voltage is expressed in 50 mV units.
  65:.\src\app/pdo.c ****        Current should be expressed in 10 mA units.
  66:.\src\app/pdo.c ****      */
  67:.\src\app/pdo.c ****     return (DIV_ROUND_UP(power * 500, voltage));
  68:.\src\app/pdo.c **** }
