 140:.\src\system/flash.c **** /*
 141:.\src\system/flash.c ****  * @brief Execute SROM LOAD FLASH API
 142:.\src\system/flash.c ****  *
 143:.\src\system/flash.c ****  * Description
 144:.\src\system/flash.c ****  * This API loads the page latch buffer with the data to be programmed in flash,
 145:.\src\system/flash.c ****  * This is the first API in FLASH ROW operation.
 146:.\src\system/flash.c ****  *
 147:.\src\system/flash.c ****  * @param data Pointer to data to be flashed
 148:.\src\system/flash.c ****  * @param flash_macro_index Flash macro number
 149:.\src\system/flash.c ****  *
 150:.\src\system/flash.c ****  * @rerurn Status of API. true if success, false otherwise
 151:.\src\system/flash.c ****  */
 152:.\src\system/flash.c **** static bool srom_load_flash_bytes_api(uint8_t *data, uint8_t flash_macro_index)
 153:.\src\system/flash.c **** {
 154:.\src\system/flash.c ****     uint8_t retValue;
 155:.\src\system/flash.c ****     /* Write 128 bytes in a temp buf which is eventually passed to SROM API. */
 156:.\src\system/flash.c ****     memcpy ((void *)&gl_srom_arg_buf[SROM_LOAD_FLASH_DATA_OFFSET], data,
ARM GAS  C:\Users\gcalb\AppData\Local\Temp\cca2l4GL.s 			page 58


 157:.\src\system/flash.c ****             CCG_FLASH_ROW_SIZE);
 158:.\src\system/flash.c **** 
 159:.\src\system/flash.c ****     /* Fill in the arguments for API. */
 160:.\src\system/flash.c ****     gl_srom_arg_buf[SROM_API_ARG0_OFFSET] = (uint32_t)
 161:.\src\system/flash.c ****                 ((flash_macro_index << SROM_LOAD_FLASH_MACRO_OFFSET) |
 162:.\src\system/flash.c ****                 (SROM_LOAD_FLASH_BYTE_ADDR << SROM_LOAD_FLASH_BYTE_ADDR_OFFSET) |
 163:.\src\system/flash.c ****                 (SROM_FLASH_API_KEY_TWO(SRPM_LOAD_FLASH_API_OPCODE) <<
 164:.\src\system/flash.c ****                 SROM_FLASH_KEY_TWO_OFFSET) | SROM_FLASH_API_KEY_ONE);
 165:.\src\system/flash.c ****     /* Number of bytes to flash - 1 */
 166:.\src\system/flash.c ****     gl_srom_arg_buf[SROM_API_ARG1_OFFSET] = CCG_FLASH_ROW_SIZE-1;
 167:.\src\system/flash.c **** 
 168:.\src\system/flash.c ****     /* SYSARG */
 169:.\src\system/flash.c ****     CPUSS->sysarg = (uint32)&gl_srom_arg_buf[SROM_API_ARG0_OFFSET];
 170:.\src\system/flash.c ****     /* SYSREQ */
 171:.\src\system/flash.c ****     CPUSS->sysreq = (CPUSS_SYSREQ_SYSCALL_REQ | SRPM_LOAD_FLASH_API_OPCODE);
 172:.\src\system/flash.c ****     /* Read the Result. */
 173:.\src\system/flash.c ****     retValue = SROM_API_RETURN_VALUE;
 174:.\src\system/flash.c ****     if (retValue != 0)
 175:.\src\system/flash.c ****     {
 176:.\src\system/flash.c ****         return false;
