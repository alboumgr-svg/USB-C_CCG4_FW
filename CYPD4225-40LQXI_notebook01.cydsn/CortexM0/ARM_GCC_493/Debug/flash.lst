 330:.\src\system/flash.c **** CY_ISR(flash_spc_intr_handler)
 331:.\src\system/flash.c **** {
 332:.\src\system/flash.c ****     flash_write_status_t status = FLASH_WRITE_COMPLETE;
 333:.\src\system/flash.c **** 
 334:.\src\system/flash.c ****     /* Check if Abort request is pending. */
 335:.\src\system/flash.c ****     if (gl_flash_nb_write_abort)
 336:.\src\system/flash.c ****     {
 337:.\src\system/flash.c ****         /*
 338:.\src\system/flash.c ****          * See if we are already in last phase of Flash update i.e the
 339:.\src\system/flash.c ****          * third interrupt. If yes, there is no point in aborting the flash as there
 340:.\src\system/flash.c ****          * is nothing left to abort.
