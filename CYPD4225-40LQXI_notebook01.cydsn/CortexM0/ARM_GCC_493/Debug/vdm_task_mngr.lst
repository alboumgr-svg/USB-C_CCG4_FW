 532:.\src\app\alt_mode/vdm_task_mngr.c ****             if (svid == NO_DATA)
 533:.\src\app\alt_mode/vdm_task_mngr.c ****             {
 534:.\src\app\alt_mode/vdm_task_mngr.c ****                 retval = true;
 535:.\src\app\alt_mode/vdm_task_mngr.c ****             }
 536:.\src\app\alt_mode/vdm_task_mngr.c ****             else
 537:.\src\app\alt_mode/vdm_task_mngr.c ****             {
 538:.\src\app\alt_mode/vdm_task_mngr.c ****                 /* If SVID not saved previously then save */
 539:.\src\app\alt_mode/vdm_task_mngr.c ****                 if (is_svid_stored(svid_arr, svid) == false)
