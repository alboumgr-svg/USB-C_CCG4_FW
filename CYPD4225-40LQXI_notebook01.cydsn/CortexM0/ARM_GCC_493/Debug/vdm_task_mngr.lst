 543:.\src\app\alt_mode/vdm_task_mngr.c **** #endif /* SAVE_SUPP_SVID_ONLY */
 544:.\src\app\alt_mode/vdm_task_mngr.c ****                     {
 545:.\src\app\alt_mode/vdm_task_mngr.c ****                         svid_arr[svid_idx] = svid;
 546:.\src\app\alt_mode/vdm_task_mngr.c ****                         svid_idx++;
