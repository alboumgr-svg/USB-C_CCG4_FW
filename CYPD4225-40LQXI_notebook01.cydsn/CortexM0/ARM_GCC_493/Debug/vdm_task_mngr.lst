 499:.\src\app\alt_mode/vdm_task_mngr.c ****  */
 500:.\src\app\alt_mode/vdm_task_mngr.c **** static bool save_svids(uint8_t port, uint16_t *svid_arr, uint8_t max_svid)
 501:.\src\app\alt_mode/vdm_task_mngr.c **** {
 502:.\src\app\alt_mode/vdm_task_mngr.c ****     uint8_t     idx, vdo_count;
 503:.\src\app\alt_mode/vdm_task_mngr.c ****     uint8_t     svid_idx = vdm_stat[port].svid_idx;
 504:.\src\app\alt_mode/vdm_task_mngr.c ****     uint16_t    svid;
 505:.\src\app\alt_mode/vdm_task_mngr.c ****     bool        retval = false;
 506:.\src\app\alt_mode/vdm_task_mngr.c **** 
 507:.\src\app\alt_mode/vdm_task_mngr.c ****     /* Compare received SVIDs with supported SVIDs */
 508:.\src\app\alt_mode/vdm_task_mngr.c ****     vdo_count = get_msg(port)->vdo_numb;
 509:.\src\app\alt_mode/vdm_task_mngr.c **** 
 510:.\src\app\alt_mode/vdm_task_mngr.c ****     /* Stop further discovery if this response does not have the maximum no. of DOs. */
 511:.\src\app\alt_mode/vdm_task_mngr.c ****     if (vdo_count < (MAX_NO_OF_DO - 1))
 512:.\src\app\alt_mode/vdm_task_mngr.c ****     {
 513:.\src\app\alt_mode/vdm_task_mngr.c ****         retval = true;
 514:.\src\app\alt_mode/vdm_task_mngr.c ****     }
 515:.\src\app\alt_mode/vdm_task_mngr.c **** 
 516:.\src\app\alt_mode/vdm_task_mngr.c ****     for (idx = 0; idx < (vdo_count * 2); idx++)
 517:.\src\app\alt_mode/vdm_task_mngr.c ****     {
 518:.\src\app\alt_mode/vdm_task_mngr.c ****         if ((idx & 1) == 0)
 519:.\src\app\alt_mode/vdm_task_mngr.c ****         {
 520:.\src\app\alt_mode/vdm_task_mngr.c ****             /* Upper half of the DO. */
 521:.\src\app\alt_mode/vdm_task_mngr.c ****             svid = get_msg(port)->vdo[idx >> 1].val >> 16u;
 522:.\src\app\alt_mode/vdm_task_mngr.c ****         }
 523:.\src\app\alt_mode/vdm_task_mngr.c ****         else
 524:.\src\app\alt_mode/vdm_task_mngr.c ****         {
 525:.\src\app\alt_mode/vdm_task_mngr.c ****             /* Lower half of the DO. */
 526:.\src\app\alt_mode/vdm_task_mngr.c ****             svid = get_msg(port)->vdo[idx >> 1].val & 0xFFFFu;
 527:.\src\app\alt_mode/vdm_task_mngr.c ****         }
 528:.\src\app\alt_mode/vdm_task_mngr.c **** 
 529:.\src\app\alt_mode/vdm_task_mngr.c ****         if (svid_idx < (max_svid - 1))
 530:.\src\app\alt_mode/vdm_task_mngr.c ****         {
