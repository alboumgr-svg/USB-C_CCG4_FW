2363:.\src\pd_hal/pdss_hal.c **** 
2364:.\src\pd_hal/pdss_hal.c **** #if CCG_HPD_RX_ENABLE
2365:.\src\pd_hal/pdss_hal.c **** /*
2366:.\src\pd_hal/pdss_hal.c ****  * CDT 245126 workaround.
2367:.\src\pd_hal/pdss_hal.c ****  * This routine implements the workaround before entering deep sleep.
2368:.\src\pd_hal/pdss_hal.c ****  * 
2369:.\src\pd_hal/pdss_hal.c ****  * Details:
2370:.\src\pd_hal/pdss_hal.c ****  * HPD RX module can't detect HPD High to Low and IRQ transitions across 
2371:.\src\pd_hal/pdss_hal.c ****  * deepsleep. Workaround is this:
2372:.\src\pd_hal/pdss_hal.c ****  *
2373:.\src\pd_hal/pdss_hal.c ****  * Before entering deepsleep, check if HPD is high. If yes, enable HPD
2374:.\src\pd_hal/pdss_hal.c ****  * TX module with default value of HIGH. Enable HPD loopback. Configure HPD
2375:.\src\pd_hal/pdss_hal.c ****  * RX to detect a high with minimum time possible (<50us). After this enter
2376:.\src\pd_hal/pdss_hal.c ****  * deepsleep. Once device enters deep sleep, HPD RX module loses all memory.
2377:.\src\pd_hal/pdss_hal.c ****  * Now, when HPD goes low, HPD IN wakeup interrupt will wake up the device.
2378:.\src\pd_hal/pdss_hal.c ****  * HPD RX module starts with HPD RX status as LOW. Due to loopback enabled and HPD
2379:.\src\pd_hal/pdss_hal.c ****  * TX driving high, HPD RX will see HPD Connect event. Then disable the loopback
2380:.\src\pd_hal/pdss_hal.c ****  * and revert HPD RX settings. From this point, HPD RX will look at actual
2381:.\src\pd_hal/pdss_hal.c ****  * HPD status and will capture HPD events correctly.
2382:.\src\pd_hal/pdss_hal.c ****  *
2383:.\src\pd_hal/pdss_hal.c ****  * FW also uses a HPD RX activity timer. Whenever HPD IN interrupt fires, start this
2384:.\src\pd_hal/pdss_hal.c ****  * timer with maximum HPD event time period. This is currently set to 5ms and can be fine
2385:.\src\pd_hal/pdss_hal.c ****  * tuned if required. This ensures that on any HPD activity, device remains active
2386:.\src\pd_hal/pdss_hal.c ****  * till the HPD event is captured in HPD RX queue. Stop the timer once HPD Queue
2387:.\src\pd_hal/pdss_hal.c ****  * interrupt fires.
2388:.\src\pd_hal/pdss_hal.c ****  */
2389:.\src\pd_hal/pdss_hal.c **** 
2390:.\src\pd_hal/pdss_hal.c **** /*
2391:.\src\pd_hal/pdss_hal.c ****  * This flag keeps track of HPD Connection status. It is used in HPD CHANGE wakeup
2392:.\src\pd_hal/pdss_hal.c ****  * interrupt.
2393:.\src\pd_hal/pdss_hal.c ****  */
2394:.\src\pd_hal/pdss_hal.c **** bool gl_hpd_state = false;
2395:.\src\pd_hal/pdss_hal.c **** 
2396:.\src\pd_hal/pdss_hal.c **** void hpd_rx_sleep_entry(uint8_t port, bool hpd_state)
2397:.\src\pd_hal/pdss_hal.c **** {
2398:.\src\pd_hal/pdss_hal.c ****     PPDSS_REGS_T pd;
2399:.\src\pd_hal/pdss_hal.c ****     pd = gl_pdss[port];
2400:.\src\pd_hal/pdss_hal.c ****     
2401:.\src\pd_hal/pdss_hal.c ****     /* Store HPD Connection status. */
2402:.\src\pd_hal/pdss_hal.c ****     gl_hpd_state = hpd_state;
2403:.\src\pd_hal/pdss_hal.c ****     
2404:.\src\pd_hal/pdss_hal.c ****     if (hpd_receive_enable[port])
2405:.\src\pd_hal/pdss_hal.c ****     {
2406:.\src\pd_hal/pdss_hal.c ****         /* If HPD is connected, implement the CDT 245126 workaround. */
2407:.\src\pd_hal/pdss_hal.c ****         if (hpd_state)
2408:.\src\pd_hal/pdss_hal.c ****         {            
2409:.\src\pd_hal/pdss_hal.c ****             /* Ensure default level of HPD TX is high. */
2410:.\src\pd_hal/pdss_hal.c ****             pd->hpdt_ctrl1 |= PDSS_HPDT_CTRL1_DEFAULT_LEVEL;
2411:.\src\pd_hal/pdss_hal.c ****             /* Enable HPD TX. */
2412:.\src\pd_hal/pdss_hal.c ****             pd->ctrl |= PDSS_CTRL_HPDT_ENABLED;
2413:.\src\pd_hal/pdss_hal.c ****             
2414:.\src\pd_hal/pdss_hal.c ****             /* Enable HPD loop back. */
2415:.\src\pd_hal/pdss_hal.c ****             pd->hpd_ctrl1 |= PDSS_HPD_CTRL1_LOOPBACK_EN;
2416:.\src\pd_hal/pdss_hal.c ****             
2417:.\src\pd_hal/pdss_hal.c ****             /* Update HPD RX Stable High minimum time to a very small value (<50us) */
2418:.\src\pd_hal/pdss_hal.c ****             pd->hpd_ctrl3 = ((pd->hpd_ctrl3 & ~PDSS_HPD_CTRL3_STABLE_HIGH_MASK)
2419:.\src\pd_hal/pdss_hal.c ****                 | (1 << PDSS_HPD_CTRL3_STABLE_HIGH_POS));
ARM GAS  C:\Users\gcalb\AppData\Local\Temp\ccZdHskf.s 			page 665


2420:.\src\pd_hal/pdss_hal.c ****             pd->hpd_ctrl5 = ((pd->hpd_ctrl5 & ~PDSS_HPD_CTRL5_LONG_HIGH_MASK)
2421:.\src\pd_hal/pdss_hal.c ****                 | (1 << PDSS_HPD_CTRL5_LONG_HIGH_POS));
2422:.\src\pd_hal/pdss_hal.c ****             
2423:.\src\pd_hal/pdss_hal.c ****             /*
2424:.\src\pd_hal/pdss_hal.c ****              * Disable HPD Queue interrupt. There is no point in using Queue interrupt
2425:.\src\pd_hal/pdss_hal.c ****              * for HPD high detection once device wakes up. We can poll for this.
2426:.\src\pd_hal/pdss_hal.c ****              */
2427:.\src\pd_hal/pdss_hal.c ****             pd->intr2 = PDSS_INTR2_HPD_QUEUE;
2428:.\src\pd_hal/pdss_hal.c ****             pd->intr2_mask &= ~PDSS_INTR2_MASK_HPD_QUEUE_MASK;
2429:.\src\pd_hal/pdss_hal.c ****         }
2430:.\src\pd_hal/pdss_hal.c ****     }
2431:.\src\pd_hal/pdss_hal.c **** }
2432:.\src\pd_hal/pdss_hal.c **** 
2433:.\src\pd_hal/pdss_hal.c **** /* CDT 245126 workaround: This routine implements the wakeup portion of workaround. */
2434:.\src\pd_hal/pdss_hal.c **** void hpd_rx_wakeup(uint8_t port)
2435:.\src\pd_hal/pdss_hal.c **** {
2436:.\src\pd_hal/pdss_hal.c ****     PPDSS_REGS_T pd;
2437:.\src\pd_hal/pdss_hal.c ****     pd = gl_pdss[port];
2438:.\src\pd_hal/pdss_hal.c ****     uint8_t timeout = 0;
2439:.\src\pd_hal/pdss_hal.c ****     
2440:.\src\pd_hal/pdss_hal.c ****     if (hpd_receive_enable[port])
2441:.\src\pd_hal/pdss_hal.c ****     {
2442:.\src\pd_hal/pdss_hal.c ****         /* Revert the settings only if Loopback was enabled before entering deep sleep. */
2443:.\src\pd_hal/pdss_hal.c ****         if (pd->hpd_ctrl1 & PDSS_HPD_CTRL1_LOOPBACK_EN)
2444:.\src\pd_hal/pdss_hal.c ****         {           
2445:.\src\pd_hal/pdss_hal.c ****             /*
2446:.\src\pd_hal/pdss_hal.c ****              * Wait for the HPD Queue connect event. This is the fake HPD Queue connect
2447:.\src\pd_hal/pdss_hal.c ****              * event triggered due to CDT 245126 workaround. 20us wait is enough.
2448:.\src\pd_hal/pdss_hal.c ****              */
2449:.\src\pd_hal/pdss_hal.c ****             while ((HPD_GET_EVENT_0(pd->hpd_queue) != HPD_EVENT_PLUG) && (timeout < 20))
2450:.\src\pd_hal/pdss_hal.c ****             {
2451:.\src\pd_hal/pdss_hal.c ****                 CyDelayUs (1);
2452:.\src\pd_hal/pdss_hal.c ****                 timeout++;
2453:.\src\pd_hal/pdss_hal.c ****             }
2454:.\src\pd_hal/pdss_hal.c **** 
2455:.\src\pd_hal/pdss_hal.c ****             /* Ensure that HPD RX high time is reset back to default. */
2456:.\src\pd_hal/pdss_hal.c ****             pd->hpd_ctrl3 = PDSS_HPD_CTRL3_DEFAULT_VALUE;
2457:.\src\pd_hal/pdss_hal.c ****             pd->hpd_ctrl5 = PDSS_HPD_CTRL5_DEFAULT;
2458:.\src\pd_hal/pdss_hal.c ****             /* Ensure that Loopback is disabled. */
2459:.\src\pd_hal/pdss_hal.c ****             pd->hpd_ctrl1 &= ~PDSS_HPD_CTRL1_LOOPBACK_EN;
2460:.\src\pd_hal/pdss_hal.c ****         }
2461:.\src\pd_hal/pdss_hal.c ****         /* Enable the HPD Queue interrupt to capture true HPD interrupts from now on. */
2462:.\src\pd_hal/pdss_hal.c ****         pd->intr2 = PDSS_INTR2_HPD_QUEUE;
2463:.\src\pd_hal/pdss_hal.c ****         pd->intr2_mask |= PDSS_INTR2_MASK_HPD_QUEUE_MASK;
2464:.\src\pd_hal/pdss_hal.c ****     }
2465:.\src\pd_hal/pdss_hal.c **** }
2466:.\src\pd_hal/pdss_hal.c **** 
2467:.\src\pd_hal/pdss_hal.c **** bool is_hpd_rx_state_idle(uint8_t port)
2468:.\src\pd_hal/pdss_hal.c **** {
2469:.\src\pd_hal/pdss_hal.c ****     /* If timer is running, HPD RX module is busy. */
2470:.\src\pd_hal/pdss_hal.c ****     return (!timer_is_running (port, HPD_RX_ACTIVITY_TIMER_ID));
2471:.\src\pd_hal/pdss_hal.c **** }
