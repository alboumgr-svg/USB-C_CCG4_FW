  50:.\src\app/psource.c **** /* Type-C current levels in 10mA units. */
  51:.\src\app/psource.c **** #define CUR_LEVEL_3A    300
  52:.\src\app/psource.c **** #define CUR_LEVEL_1_5A  150
  53:.\src\app/psource.c **** #define CUR_LEVEL_DEF   90
  54:.\src\app/psource.c **** 
  55:.\src\app/psource.c **** static void psrc_dis_ovp(uint8_t port);
  56:.\src\app/psource.c **** void psrc_en_ovp(uint8_t port);
  57:.\src\app/psource.c **** static void psrc_dis_ocp(uint8_t port);
  58:.\src\app/psource.c **** static void psrc_shutdown(uint8_t port, bool discharge_dis);
  59:.\src\app/psource.c **** 
  60:.\src\app/psource.c **** static void app_psrc_tmr_cbk(uint8_t port, timer_id_t id);
