  62:.\src\app/psource.c **** void app_psrc_vbus_ocp_cbk(uint8_t port);
  63:.\src\app/psource.c **** 
  64:.\src\app/psource.c **** static void psrc_select_voltage(uint8_t port);
  65:.\src\app/psource.c **** 
  66:.\src\app/psource.c **** static void vbus_fet_on(uint8_t port)
  67:.\src\app/psource.c **** {
  68:.\src\app/psource.c ****     app_get_status(port)->is_vbus_on = true;
  69:.\src\app/psource.c ****     if(port == TYPEC_PORT_0_IDX)
  70:.\src\app/psource.c ****     {
  71:.\src\app/psource.c ****         APP_VBUS_SNK_FET_OFF_P1();
  72:.\src\app/psource.c ****         CyDelayUs(10);
